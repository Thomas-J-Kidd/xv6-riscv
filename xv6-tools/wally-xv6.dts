/dts-v1/;

/ {
    #address-cells = <0x02>;
    #size-cells = <0x02>;
    compatible = "wally-virt";
    model = "wally-virt,xv6";

    chosen {
        bootargs = "console=ttyS0,115200";
        stdout-path = "/soc/uart@10000000";
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x00 0x80000000 0x00 0x8000000>; // 128MB
    };

    cpus {
        #address-cells = <0x01>;
        #size-cells = <0x00>;
        timebase-frequency = <20000000>;    // 20MHz clock
        cpu@0 {
            phandle = <0x01>;
            device_type = "cpu";
            reg = <0x00>;
            status = "okay";
            compatible = "riscv";
            riscv,isa = "rv64imafdcsu";
            mmu-type = "riscv,sv48";

            cpu_intc0: interrupt-controller {
                #interrupt-cells = <0x01>;
                #address-cells = <0x00>;
                interrupt-controller;
                compatible = "riscv,cpu-intc";
                phandle = <0x02>;
            };
        };
    };

    soc {
        #address-cells = <0x02>;
        #size-cells = <0x02>;
        compatible = "simple-bus";
        ranges;

        uart@10000000 {
            interrupts = <0x0a>;
            interrupt-parent = <0x03>;
            clock-frequency = <20000000>;
            reg = <0x00 0x10000000 0x00 0x100>;
            compatible = "ns16550a";
        };

        plic@c000000 {
            phandle = <0x03>;
            riscv,ndev = <0x35>;
            reg = <0x00 0xc000000 0x00 0x210000>;
            interrupts-extended = <&cpu_intc0 0x0b &cpu_intc0 0x09>;
            interrupt-controller;
            compatible = "sifive,plic-1.0.0", "riscv,plic0";
            #interrupt-cells = <0x01>;
            #address-cells = <0x00>;
        };

        clint@2000000 {
            interrupts-extended = <&cpu_intc0 0x03 &cpu_intc0 0x07>;
            reg = <0x00 0x2000000 0x00 0x10000>;
            compatible = "sifive,clint0", "riscv,clint0";
        };

        spi@13000 {
            compatible = "sifive,spi0";
            reg = <0x0 0x13000 0x0 0x1000>;
            interrupt-parent = <0x03>;
            interrupts = <0x14>;
            clocks = <&refclk>;
            #address-cells = <1>;
            #size-cells = <0>;

            mmc@0 {
                compatible = "mmc-spi-slot";
                reg = <0>;
                spi-max-frequency = <20000000>;
                voltage-ranges = <3300 3300>;
                disable-wp;
            };
        };

        refclk: refclk {
            #clock-cells = <0>;
            compatible = "fixed-clock";
            clock-frequency = <20000000>;
            clock-output-names = "xtal";
            reg = <0x0 0x0 0x0 0x0>;
        };
    };
};
